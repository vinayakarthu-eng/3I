DATABASE_URL=postgresql://drillforce:drillforce@localhost:5432/drillforce
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slack (apps/slack-bot + Settings → Integrations) — see apps/slack-bot/README.md
# Each org connects its own workspace with "Add to Slack" (OAuth):
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Encrypts stored bot tokens + signs OAuth state. Any random string of 32+ chars; keep it stable.
SLACK_ENCRYPTION_KEY=
# App-level token (xapp-, connections:write): the bot's one Socket Mode connection for all workspaces.
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...
# Legacy single-workspace mode (optional): a bot token mapped to one org.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_LEGACY_ORG_ID=

# Claude (IC bot + AAR generation). Optional: without it the IC uses scripted lines.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# IC bot: seconds of channel silence before it posts a challenge
# IC_QUIET_MIN_SECONDS=180
# IC_QUIET_MAX_SECONDS=300
