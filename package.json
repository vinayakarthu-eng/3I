{
  "name": "drillforce",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "docker compose up -d && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "npm run db:generate -w @drillforce/db",
    "db:migrate": "npm run db:migrate -w @drillforce/db",
    "db:seed": "npm run db:seed -w @drillforce/db",
    "db:studio": "npm run db:studio -w @drillforce/db",
    "test": "turbo test",
    "demo": "tsx scripts/live-demo.mts"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
