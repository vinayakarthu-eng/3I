{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "NEXT_PUBLIC_APP_URL",
    "SLACK_BOT_TOKEN",
    "SLACK_APP_TOKEN",
    "SLACK_SIGNING_SECRET",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_MODEL",
    "SLACK_CLIENT_ID",
    "SLACK_CLIENT_SECRET",
    "SLACK_ENCRYPTION_KEY",
    "SLACK_LEGACY_ORG_ID",
    "SLACK_API_URL",
    "DD_API_KEY",
    "DD_SITE",
    "DD_OTLP_ENDPOINT",
    "SCORING_DELAY_MINUTES",
    "WAR_ROOM_URL",
    "WAR_ROOM_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {}
  }
}
