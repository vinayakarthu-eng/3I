# DrillForce War Room — configuration
# Leave the Slack tokens blank to run in simulator mode (browser dashboard only).
# Fill all three to drive the drill live in a real Slack workspace (Socket Mode).
# See SETUP.md for the exact Slack app-creation steps.

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

PORT=3000
# Drill speed multiplier: 1 = real time, 2 = 2x, 4 = 4x (injects fire faster).
DRILL_SPEED=2

# Comma-separated Slack user IDs to invite + page on every incident (your on-call).
# Find a user's ID in Slack: profile → ⋮ → "Copy member ID" (e.g. U0123ABC).
SLACK_ONCALL=

# Record every incident as a DrillForce drill (timeline, auto-scoring, AAR, webhooks) via the
# DrillForce API. Create a key in DrillForce → Settings → API keys. If DrillForce runs on :3000,
# set PORT above to something else (e.g. 3100).
DRILLFORCE_API_URL=
DRILLFORCE_API_KEY=
